rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isApprovedGuardian(patientId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(patientId)/guardians/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(patientId)/guardians/$(request.auth.uid)).data.status == 'ACCEPTED';
    }
    match /evidence/{patientId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == patientId || isApprovedGuardian(patientId));
      allow create: if signedIn()
        && request.auth.uid == patientId
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow update, delete: if signedIn() && request.auth.uid == patientId;
    }
  }
}
